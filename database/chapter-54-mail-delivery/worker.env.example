# Copy to .env.worker, chmod 600; keep separate from receipt secret.
DATABASE_URL=postgresql://owner:REPLACE@127.0.0.1:55432/epp_ch54_verify
DB_POOL_MAX=5
DB_QUERY_DEBUG=false
LOG_LEVEL=info
MAIL_PROVIDER=resend
MAIL_PROVIDER_SCOPE=practice-account
RESEND_API_KEY=REPLACE
RESEND_FROM=verified-sender@example.test
# Local SMTP route: MAIL_PROVIDER=local, LOCAL_SMTP_PORT=1025.
# The local adapter uses provider_scope=practice and real SMTP Message-ID.
