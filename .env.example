# Local development only. Production injects environment variables.
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=5000
# Optional override; development defaults to true, test/production to false.
# DOCS_ENABLED=false

# API runtime; .env.database is only loaded by the migration CLI.
DATABASE_URL="postgresql://epp_owner:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/epp_dev?schema=public"
DB_POOL_MAX=5
DB_QUERY_DEBUG=false
