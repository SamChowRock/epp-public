# Local development only. Production injects environment variables.
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=5000
# Optional override; development defaults to true, test/production to false.
# DOCS_ENABLED=false

# API runtime; .env.database is only loaded by the migration CLI.
DATABASE_URL="postgresql://epp_owner:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/epp_dev?schema=public"
DB_POOL_MAX=5
DB_QUERY_DEBUG=false

# Generate once with randomBytes(32).toString('hex'); never commit the real key.
# Required in production; omission in development/test uses an ephemeral key.
# CURSOR_HMAC_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

# Exact browser origin: no path/trailing slash. HTTP only for loopback practice.
# Production requires this explicitly; public origins must use HTTPS.
APP_ORIGIN=http://127.0.0.1:3000

# Unset means no trusted proxy. Only exact controlled proxy IPs, comma-separated.
# The proxy must overwrite forwarded headers and the API must not be publicly reachable.
# TRUST_PROXY_IPS=127.0.0.1

# Chapter 36: SMTP sink, hard-bound to loopback; never forwards to real recipients.
LOCAL_SMTP_PORT=1025

# Optional mini-program login: configure both only on the API server.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
