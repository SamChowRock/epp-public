        }
      ]
    },
    {
      "name": "08 用原Cookie读取身份",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Old session revoked', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
