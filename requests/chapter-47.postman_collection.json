            ]
          }
        }
      ]
    },
    {
      "name": "07 确认密码重置",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-EPP-Request",
