{
  "info": {
    "name": "EPP Chapter 47 Inbox Stream",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use the numbered requests individually on local VERIFY. 19 opens an authenticated event stream. Use Cancel to close it before your next experiment."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3360"
    },
    {
      "key": "email",
      "value": "reader47@example.test"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "registrationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 请求注册邮件",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-EPP-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/auth/register/request",
        "body": {
          "mode": "raw",
          "raw": "{{authBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({email: pm.variables.get(\"email\")}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    },
    {
      "name": "02 验证邮箱并设置密码",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-EPP-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/auth/register/confirm",
        "body": {
          "mode": "raw",
          "raw": "{{authBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({token: pm.variables.get(\"registrationToken\"), newPassword: pm.variables.get(\"password\")}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().userId);",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    },
    {
      "name": "03 重复消费注册令牌",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
