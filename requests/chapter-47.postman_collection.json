          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({email: pm.variables.get(\"email\"), password: pm.variables.get(\"newPassword\")}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
