    },
    {
      "name": "11 重复消费重置令牌",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-EPP-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/auth/reset/confirm",
        "body": {
          "mode": "raw",
          "raw": "{{authBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({token: pm.variables.get(\"resetToken\"), newPassword: pm.variables.get(\"newPassword\")}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    },
    {
      "name": "12 当前会话仍有效",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Current session still belongs to registered user', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().userId).to.eql(pm.collectionVariables.get('userId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 查询通知首页",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notifications?limit=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "pm.collectionVariables.set('notificationId', page.items[0]?.id || '');",
              "pm.collectionVariables.set('notificationCursor', page.nextCursor || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "14 查询下一页（首页有游标时）",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notifications?limit=1&cursor={{notificationCursor}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 取得当前会话写入令牌",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/csrf",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.environment.set('csrfToken', pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "16 标记首页通知已读",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 清除同一通知",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/notifications/{{notificationId}}",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 重新查询（保留操作目标）",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notifications?limit=20",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 打开当前账号的收件箱事件流（单发，观察后取消）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": "{{baseUrl}}/notifications/events",
        "description": "Use the current local cookie. Keep this request open to observe inbox events. Cancel to release the connection."
      }
    }
  ]
}
