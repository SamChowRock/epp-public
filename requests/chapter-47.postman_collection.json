              "pm.variables.set(\"authBody\", JSON.stringify({token: pm.variables.get(\"resetToken\"), newPassword: pm.variables.get(\"newPassword\")}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    },
    {
      "name": "08 用原Cookie读取身份",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Old session revoked', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 旧密码登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-EPP-Request",
