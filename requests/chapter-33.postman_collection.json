{
  "info": {
    "name": "EPP 第33章 会话与旧数据",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "仅对已升级的独立 VERIFY 操作。使用客户端 Cookie jar，不复制令牌到集合。密码变量只存本机；不要导出其值，不运行整个集合。改密后全部会话失效。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "userId",
      "value": "10000000-0000-4000-8000-000000000001"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "captureId",
      "value": ""
    },
    {
      "key": "learningId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "targetSessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 登录：只在本地填写密码",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{{authBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({",
              "  userId: pm.variables.get(\"userId\"),",
              "  password: pm.variables.get(\"password\"),",
              "  label: \"Postman VERIFY\",",
              "}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('sessionId', pm.response.json().sessionId);",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    },
    {
      "name": "02 当前身份",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 原素材详情",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/captures/{{captureId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 原学习来源",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-records/{{learningId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 会话列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 撤销指定会话：先填写 targetSessionId",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/auth/sessions/{{targetSessionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 退出：可重复发送",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 退出后读取：401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 主动改密：先重新登录，最后单独运行",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/password",
        "body": {
          "mode": "raw",
          "raw": "{{authBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"authBody\", JSON.stringify({",
              "  currentPassword: pm.variables.get(\"password\"),",
              "  newPassword: pm.variables.get(\"newPassword\"),",
              "}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.variables.unset(\"authBody\");"
            ]
          }
        }
      ]
    }
  ]
}
