            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures/{{captureId}}/revisions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originalText\": \"Let us pause here.\",\n  \"chineseIntent\": \"我想表达暂停讨论\"\n}",
          "options": {
