    },
    {
      "name": "09 采纳旧版候选A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidates/{{candidateA}}/accept",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{operationA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.test('来源仍是候选A',()=>pm.expect(value.learningRecord.candidateId).to.eql(pm.collectionVariables.get('candidateA')));",
              "pm.collectionVariables.set('expressionId',value.expression.id);",
              "pm.collectionVariables.set('expressionText',value.expression.forms[0].text);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 采纳旧版候选B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidates/{{candidateB}}/accept",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{operationB}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.test('来源仍是候选B',()=>pm.expect(value.learningRecord.candidateId).to.eql(pm.collectionVariables.get('candidateB')));",
              "pm.test('复用相同表达',()=>pm.expect(value.expression.id).to.eql(pm.collectionVariables.get('expressionId')));",
              "pm.collectionVariables.set('replayB',JSON.stringify(value));",
              "pm.collectionVariables.set('learningId',value.learningRecord.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 采纳旧版候选C",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/candidates/{{candidateC}}/accept",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{operationC}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.test('来源仍是候选C',()=>pm.expect(value.learningRecord.candidateId).to.eql(pm.collectionVariables.get('candidateC')));",
              "pm.test('不同义项分别保存',()=>pm.expect(value.expression.id).not.to.eql(pm.collectionVariables.get('expressionId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 有界星图",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/star-map?limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();",
              "pm.test('星图首页最多 100 个节点', () => {",
              "  pm.expect(value.limit).to.eql(100);",
              "  pm.expect(value.nodes).to.be.an('array');",
              "  pm.expect(value.nodes.length).to.be.at.most(value.limit);",
              "  pm.expect(value.hasMore).to.be.a('boolean');",
              "  if (value.hasMore) pm.expect(value.nodes.length).to.eql(value.limit);",
              "});",
              "pm.test('可见节点有来源且不公开比较键', () => {",
              "  for (const node of value.nodes) {",
              "    pm.expect(Number.isInteger(node.recordCount)).to.eql(true);",
              "    pm.expect(node.recordCount).to.be.at.least(1);",
              "    pm.expect(node).not.to.have.property('semanticKey');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 仅取一条学习记录",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-records?limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();",
              "pm.test('明确截取',()=>{pm.expect(value.items.length).to.eql(1);pm.expect(value.hasMore).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 按表达读取来源",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-records?expressionId={{expressionId}}&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();",
              "pm.test('筛选保持表达身份',()=>pm.expect(value.items.every(x=>x.expression.id===pm.collectionVariables.get('expressionId'))).to.eql(true));",
              "pm.test('A 与 B 各有自己的学习记录', () => {",
              "  const findSource = key => value.items.find(item => item.source.candidateId === pm.collectionVariables.get(key));",
              "  const a = findSource('candidateA');",
              "  const b = findSource('candidateB');",
              "  pm.expect(a).to.be.an('object');",
              "  pm.expect(b).to.be.an('object');",
              "  pm.expect(a.id).not.to.eql(b.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15 查看B的历史详情",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-records/{{learningId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const value=pm.response.json();",
              "pm.test('详情是旧修订',()=>{pm.expect(value.source.revisionId).to.eql(pm.collectionVariables.get('revisionId'));pm.expect(value.source.originalText).to.eql('I need a break.');});",
              "pm.test('候选与正式形式各自保留',()=>{pm.expect(value.source.englishText).to.eql(pm.collectionVariables.get('candidateBText'));pm.expect(value.expression.text).to.eql(pm.collectionVariables.get('expressionText'));pm.expect(value.source.candidateId).to.eql(pm.collectionVariables.get('candidateB'));});"
            ]
          }
        }
      ]
    },
