{
  "info": {
    "name": "EPP 第32章 查询接口",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "本机隔离实践。从01开始会建立新样本；中断后保留变量从下一项继续。仅采纳以保存的operationId重试。",
    "_postman_id": "f65edb23-6e54-4040-826a-1bd97ae295c5"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "01 新建输入",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originalText\": \"I need a break.\",\n  \"chineseIntent\": \"我想表达先休息一下\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['captureId','revisionId','newRevisionId','expressionId','expressionText','candidateBText','replayB',...['A','B','C','D','E'].map(x=>'candidate'+x)].forEach(x=>pm.collectionVariables.unset(x));",
              "['A','B','C','D'].forEach(x=>pm.collectionVariables.set('operation'+x, pm.variables.replaceIn('{{$guid}}')));",
              "pm.collectionVariables.unset('learningId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.collectionVariables.set('captureId', value.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 保存初始修订",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/captures/{{captureId}}/revisions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const value = pm.response.json();",
              "pm.collectionVariables.set('revisionId', value.items[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 保存候选A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/revisions/{{revisionId}}/candidates",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"candidateNo\": 1,\n  \"englishText\": \"Take a break.\",\n  \"chineseMeaning\": \"休息一下\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.collectionVariables.set('candidateA', value.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 保存候选B",
      "request": {
