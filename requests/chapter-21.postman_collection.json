    {
      "name": "POST 1001 单元：B 拒绝，C 创建",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures",
        "body": {
          "mode": "raw",
          "raw": "{\"originalText\":\"Chapter 21 create boundary\", \"chineseIntent\": {{intentJson}}}",
          "options": {
