    {
      "name": "GET 列表（含长值时 A 返回 500）",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/captures"
      }
    },
    {
      "name": "PATCH 缺失意图：400",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures/{{captureId}}",
        "body": {
          "mode": "raw",
