          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PATCH 清空：200，按需手动发送",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures/{{captureId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"chineseIntent\":null}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
