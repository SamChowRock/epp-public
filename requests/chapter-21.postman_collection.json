{
  "info": {
    "name": "EPP 第24章：字段放宽与读写兼容",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "逐项手动发送，先新建本章记录并复制 id。Scripts 的 Pre-request 只产生长度明确的正文变量，不发送额外请求、不自动清理数据。A为第23章；B为兼容读取阶段；C为第24章最终版。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "captureId",
      "value": "填写本章新建记录的ID"
    }
  ],
  "item": [
    {
      "name": "01 新建本章实验记录：复制 id 到 captureId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures",
        "body": {
          "mode": "raw",
          "raw": "{\"originalText\": \"Chapter 21 compatibility sample\", \"chineseIntent\": \"原有短意图\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 按 ID 读取（A/B/C 对照）",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/captures/{{captureId}}"
      }
    },
    {
      "name": "PATCH 1000 单元：B≤1000，C≤2000",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures/{{captureId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"chineseIntent\": {{intentJson}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"intentJson\", JSON.stringify(\"长\".repeat(1000)));"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH 1001 单元：B≤1000，C≤2000",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures/{{captureId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"chineseIntent\": {{intentJson}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"intentJson\", JSON.stringify(\"长\".repeat(1001)));"
            ]
          }
        }
      ]
    },
    {
