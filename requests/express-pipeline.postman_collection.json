{
  "info": {
    "name": "EPP Express 请求链实验",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "本机独立实验；逐条手动 Send，不自动重放。挂起请求约两秒后 Cancel；断点暂停时不要用短超时判断服务故障。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3003",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 等待与 next",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wait"
      }
    },
    {
      "name": "02 提前响应",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/stop"
      }
    },
    {
      "name": "03 Promise 失败",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/fail"
      }
    },
    {
      "name": "04 回调失败",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/callback-fail"
      }
    },
    {
      "name": "05 未匹配",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/missing"
      }
    },
    {
      "name": "06 遗漏响应：两秒后 Cancel",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/hang"
      }
    },
    {
      "name": "07 合法 JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/echo",
        "body": {
          "mode": "raw",
          "raw": "{\"message\":\"hello\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 非法 JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/echo",
        "body": {
          "mode": "raw",
          "raw": "{",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 超过 1 KiB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/echo",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
