              "pm.test('资料卡只含指定账号的 ID 和可空昵称', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.have.all.keys('userId', 'nickname');",
              "  pm.expect(data.userId).to.eql(pm.variables.get('profileTargetId'));",
              "  pm.expect(data.nickname === null || typeof data.nickname === 'string').to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "24 上传头像并查看临时预览",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/profile/avatar/preview",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "examples/avatar-preview/harbor.png"
          }
        },
        "description": "在 Body → binary 选择本机 harbor.png。换用 harbor.jpg 时同步将 Content-Type 改为 image/jpeg。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('返回一次 WebP 预览', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\/webp(?:;|$)/i);",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "  const bytes = pm.response.stream;",
              "  pm.expect(Array.from(bytes.slice(0, 4))).to.eql([82, 73, 70, 70]);",
              "  pm.expect(Array.from(bytes.slice(8, 12))).to.eql([87, 69, 66, 80]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "25 发布本人的新头像",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/profile/avatar",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "examples/avatar-preview/harbor.png"
          }
        },
        "description": "选择本地 PNG/JPEG，Content-Type 与文件匹配。成功时会替换此账号当前头像。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('发布成功并返回版本 ID', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().avatarId).to.match(/^[0-9a-f-]{36}$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "26 取得本人当前头像的短期读地址",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/profile/avatar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('当前身份的头像读取结果符合实验预期', () => {",
              "  const expected = Number(pm.variables.get('expectedAvatarStatus'));",
              "  pm.expect([200, 404]).to.include(expected);",
              "  pm.response.to.have.status(expected);",
              "  const data = pm.response.json();",
              "  if (expected === 404) {",
              "    pm.expect(data.code).to.eql('AVATAR_NOT_FOUND');",
              "    return;",
              "  }",
              "  pm.expect(typeof data.url === 'string' && data.url.includes('X-Amz-Signature=')).to.eql(true);",
              "  pm.expect(data.expiresIn).to.eql(30);",
              "  pm.expect(data.avatarId).to.match(/^[0-9a-f-]{36}$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "27 设置本人的头像是否展示",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/profile/avatar/visibility",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{profileBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const setting = String(pm.variables.get('avatarVisible'));",
              "if (!['true', 'false'].includes(setting)) throw new Error('avatarVisible 请填 true 或 false');",
              "pm.variables.set('profileBody', JSON.stringify({visible: setting === 'true'}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('本人读到刚保存的可见性', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.visible).to.eql(String(pm.variables.get('avatarVisible')) === 'true');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "28 以访客身份取得指定账号头像",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/profiles/{{profileTargetId}}/avatar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('当前身份的头像读取结果符合实验预期', () => {",
              "  const expected = Number(pm.variables.get('expectedAvatarStatus'));",
              "  pm.expect([200, 404]).to.include(expected);",
              "  pm.response.to.have.status(expected);",
              "  const data = pm.response.json();",
              "  if (expected === 404) {",
              "    pm.expect(data.code).to.eql('AVATAR_NOT_FOUND');",
              "    return;",
              "  }",
              "  pm.expect(typeof data.url === 'string' && data.url.includes('X-Amz-Signature=')).to.eql(true);",
              "  pm.expect(data.expiresIn).to.eql(30);",
              "  pm.expect(data.avatarId).to.match(/^[0-9a-f-]{36}$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "29 回查本人的头像可见性",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/profile/avatar/visibility"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('回读头像开关', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().visible).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
