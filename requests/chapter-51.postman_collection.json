          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const setting = String(pm.variables.get('nicknameVisible'));",
              "if (!['true', 'false'].includes(setting)) throw new Error('nicknameVisible 请填 true 或 false');",
              "pm.variables.set('profileBody', JSON.stringify({nicknameVisible: setting === 'true'}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('本人读到刚保存的可见性', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.have.all.keys('userId', 'nickname', 'nicknameVisible');",
              "  pm.expect(data.nicknameVisible).to.eql(String(pm.variables.get('nicknameVisible')) === 'true');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "23 查看指定账号的资料卡",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/profiles/{{profileTargetId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
