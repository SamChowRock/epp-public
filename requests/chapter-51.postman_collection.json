    {
      "name": "20 读取当前账号自己的资料",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/profile/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('本人资料使用三个字段', () => {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.have.all.keys('userId', 'nickname', 'nicknameVisible');",
              "  pm.expect(data.nicknameVisible).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "21 修改当前账号的昵称",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/profile/me",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{profileBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const nickname = pm.variables.get('nickname');",
              "pm.variables.set('profileBody', JSON.stringify({nickname}).replaceAll('{{', '\\\\u007b\\\\u007b'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('本次改名符合预期', () => {",
              "  const expected = Number(pm.variables.get('expectedRenameStatus'));",
              "  pm.expect([200, 429]).to.include(expected);",
              "  pm.response.to.have.status(expected);",
              "  const data = pm.response.json();",
              "  if (expected === 429) {",
              "    pm.expect(data.code).to.eql('NICKNAME_CHANGE_LIMIT');",
              "    return;",
              "  }",
              "  pm.expect(data).to.have.all.keys('userId', 'nickname', 'nicknameVisible');",
              "  pm.expect(data.nickname).to.eql(pm.variables.get('nickname').normalize('NFC').trim());",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "22 修改当前账号的昵称可见性",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/profile/me",
        "header": [
          {
            "key": "X-EPP-Request",
            "value": "1"
          },
          {
            "key": "X-CSRF-Token",
