{
  "info": {
    "name": "EPP 第29章 分页与时间",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "本机独立实践。01至11新建演示样本；12以后读取或采纳D。先读本章步骤，不要整组盲跑。游标有30分钟期限，过期重取首页。",
    "_postman_id": "f60a58fa-3caa-4464-90c3-2f75b8f6c124"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "01 新建输入",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/captures",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originalText\": \"I need a break.\",\n  \"chineseIntent\": \"我想表达先休息一下\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['captureId','revisionId','newRevisionId','expressionId','replayB',...['A','B','C','D','E'].map(x=>'candidate'+x)].forEach(x=>pm.collectionVariables.unset(x));",
              "['A','B','C','D'].forEach(x=>pm.collectionVariables.set('operation'+x, pm.variables.replaceIn('{{$guid}}')));",
              "pm.collectionVariables.unset('learningId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.collectionVariables.set('captureId', value.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 保存初始修订",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/captures/{{captureId}}/revisions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const value = pm.response.json();",
              "pm.collectionVariables.set('revisionId', value.items[0].id);"
            ]
          }
        }
      ]
    },
