          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const value = pm.response.json();",
              "pm.test('来源仍是候选B',()=>pm.expect(value.learningRecord.candidateId).to.eql(pm.collectionVariables.get('candidateB')));",
              "pm.test('复用相同表达',()=>pm.expect(value.expression.id).to.eql(pm.collectionVariables.get('expressionId')));",
              "pm.collectionVariables.set('replayB',JSON.stringify(value));",
              "pm.collectionVariables.set('learningId',value.learningRecord.id);"
            ]
          }
        }
      ]
    },
