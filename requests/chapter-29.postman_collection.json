            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('legacy shape',()=>pm.expect(Object.keys(pm.response.json()).sort()).eql(['hasMore','items','limit']));"
            ]
          }
        }
      ]
