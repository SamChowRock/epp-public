{
  "name": "epp-book-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "start": "node --enable-source-maps dist/src/server.js",
    "debug": "node --enable-source-maps --inspect-brk=127.0.0.1:9229 dist/src/server.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/express": "5.0.6"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "express": "5.2.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
