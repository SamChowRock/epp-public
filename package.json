{
  "name": "epp-book-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "prisma": "node node_modules/prisma/build/index.js",
    "db": "node --env-file=.env.database node_modules/prisma/build/index.js",
    "db:verify": "node --env-file=.env.database-verify node_modules/prisma/build/index.js",
    "prisma:generate": "npm run prisma -- generate",
    "predev": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "NODE_ENV=production node --enable-source-maps dist/src/server.js",
    "debug": "NODE_ENV=development node --env-file-if-exists=.env --enable-source-maps --inspect-brk=127.0.0.1:9229 dist/src/server.js",
    "dev:pipeline": "NODE_ENV=development node --env-file-if-exists=.env scripts/dev.mjs .dev/src/labs/request-pipeline-server.js",
    "test": "npm run build && NODE_ENV=test node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm run build",
    "dev:lifecycle": "NODE_ENV=development PORT=3007 node --env-file-if-exists=.env scripts/dev.mjs .dev/src/labs/lifecycle-server.js",
    "dev:express": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-preserve-output --inspect=127.0.0.1:9229 examples/express-pipeline.js",
    "dev:responses": "NODE_ENV=development node --env-file-if-exists=.env scripts/dev.mjs .dev/examples/controller-responses/main.js examples/controller-responses/tsconfig.dev.json",
    "dev:worker": "NODE_ENV=development node --env-file=.env.worker scripts/dev.mjs .worker-dev/src/mail-worker.js tsconfig.worker-dev.json",
    "start:worker": "NODE_ENV=production node --enable-source-maps dist/src/mail-worker.js"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.16.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
