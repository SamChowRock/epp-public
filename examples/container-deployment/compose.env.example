# Compose interpolation only. These are not application credentials.
# Set the immutable local image ID returned by docker image inspect after chapter 73.
# A verified registry repository@sha256:digest can also be used after pulling it.
EPP_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOCAL_IMAGE_ID
EPP_DATABASE=REPLACE_WITH_EXISTING_DATABASE_NAME
# Confirm the source address through the actual host-to-container path before handoff.
EPP_TRUST_PROXY_IP=172.28.74.1

# Chapter 76: independently copy the expected target from the handoff record.
EPP_S3_ENDPOINT=https://api.epp.test:9443
EPP_S3_BUCKET=avatars
