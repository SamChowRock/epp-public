# Copy outside the repository/build context. Replace every REPLACE_* value.
# Loaded by node --env-file=/run/epp/api.env, not automatically by the image.
NODE_ENV=production
LISTEN_HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://api.epp.test:8443
CURSOR_HMAC_KEY=REPLACE_WITH_EXISTING_64_LOWERCASE_HEX_KEY
DATABASE_URL=postgresql://epp_api:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_REACHABLE_DB_HOST:5432/REPLACE_WITH_EXPECTED_DATABASE?schema=public
DB_POOL_MAX=5
DB_QUERY_DEBUG=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=20000
DOCS_ENABLED=false
# Unset TRUST_PROXY_IPS means forwarded client addresses are not trusted.
# Set only exact controlled proxy addresses after verifying the actual peer IP.
# TRUST_PROXY_IPS=REPLACE_WITH_EXACT_PROXY_IP
# All four S3 values must be supplied together for persisted avatars.
AVATAR_S3_ENDPOINT=https://objects.epp.test:8444
AVATAR_S3_BUCKET=avatars
AVATAR_S3_ACCESS_KEY=REPLACE_WITH_EXISTING_APP_ACCESS_KEY
AVATAR_S3_SECRET_KEY=REPLACE_WITH_EXISTING_APP_SECRET
# Public practice root certificate; never mount the CA signing private key.
# Also set this non-secret path in the container environment before Node starts.
# NODE_EXTRA_CA_CERTS=/run/epp/root.crt
