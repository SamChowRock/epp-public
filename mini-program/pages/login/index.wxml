<view class="page">
  <view>已有 EPP 账号，请先关联，避免先创建另一个账号。</view>
  <input placeholder="已有账号 userId" value="{{userId}}" bindinput="onUserId" />
  <input placeholder="已有账号密码，仅关联时使用" password value="{{password}}" bindinput="onPassword" />
  <button bindtap="link" disabled="{{busy}}">验证密码并关联</button>
  <button bindtap="login" disabled="{{busy}}">登录或建立新账号</button>
  <button bindtap="read" disabled="{{busy}}">读取我的素材</button>
  <button bindtap="logout" disabled="{{busy}}">退出</button>
  <view selectable>{{message}}</view>
</view>
