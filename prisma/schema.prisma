generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id(map: "users_pkey") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  commandReceipts CommandReceipt[]
  expressions Expression[]
  captures  Capture[]
  learningRecords LearningRecord[]
  passwordCredential PasswordCredential?
  sessions Session[]

  @@map("users")
}

/// Session digests and lifetime constraints are maintained in migration SQL.
model Session {
  id String @id(map: "sessions_pkey") @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenDigest String @unique(map: "sessions_token_digest_key") @map("token_digest") @db.Text
  label String @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_user_id_fkey")

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@map("sessions")
}

model PasswordCredential {
  userId String @id(map: "password_credentials_pkey") @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "password_credentials_user_id_fkey")

  @@map("password_credentials")
}

/// CHECK constraints are maintained in migration SQL.
model Capture {
  id           String   @id(map: "captures_pkey") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  originalText String   @map("original_text") @db.Text
  chineseIntent String? @map("chinese_intent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revisions    CaptureRevision[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "captures_user_id_fkey")

  @@index([userId], map: "captures_user_id_idx")
  @@map("captures")
}

/// Content snapshots. CHECK constraints are maintained in migration SQL.
model CaptureRevision {
  id            String   @id(map: "capture_revisions_pkey") @db.Uuid
  captureId     String   @map("capture_id") @db.Uuid
  revisionNo    Int      @map("revision_no")
  originalText  String   @map("original_text") @db.Text
  chineseIntent String?  @map("chinese_intent") @db.Text
  inputSource   String   @map("input_source") @db.Text
  chunks        Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  capture       Capture  @relation(fields: [captureId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "capture_revisions_capture_id_fkey")
  candidates    Candidate[]

  @@unique([captureId, revisionNo], map: "capture_revisions_capture_no_key")
  @@map("capture_revisions")
}

/// Candidate content is immutable through the API; CHECK constraints live in SQL.
model Candidate {
  id             String   @id(map: "candidates_pkey") @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  candidateNo    Int      @map("candidate_no")
  englishText    String   @map("english_text") @db.Text
  chineseMeaning String   @map("chinese_meaning") @db.Text
  status         String   @default("pending") @db.Text
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  commandReceipts CommandReceipt[]
  learningRecord LearningRecord?
  discardedAt    DateTime? @map("discarded_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revision       CaptureRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "candidates_revision_id_fkey")

  @@unique([revisionId, candidateNo], map: "candidates_revision_no_key")
  @@map("candidates")
}

/// A nullable key retains historical duplicates without rewriting their references.
model Expression {
  userId String @map("user_id") @db.Uuid
  normalizedMeaning String @map("normalized_meaning") @db.Text
  semanticKey String? @map("semantic_key") @db.Text
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expressions_user_id_fkey")
  id        String @id(map: "expressions_pkey") @db.Uuid
  meaning   String @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  forms     ExpressionForm[]
  learningRecords LearningRecord[]
  @@unique([userId, semanticKey], map: "expressions_user_semantic_key")
  @@map("expressions")
}

model ExpressionForm {
  normalizedText String @map("normalized_text") @db.Text
  id           String @id(map: "expression_forms_pkey") @db.Uuid
  expressionId String @map("expression_id") @db.Uuid
  text         String @db.Text
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expression_forms_expression_id_fkey")
  @@index([expressionId], map: "expression_forms_expression_id_idx")
  @@map("expression_forms")
}

model LearningRecord {
  id           String @id(map: "learning_records_pkey") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  candidateId  String @unique(map: "learning_records_candidate_id_key") @map("candidate_id") @db.Uuid
  expressionId String @map("expression_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "learning_records_user_id_fkey")
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "learning_records_candidate_id_fkey")
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "learning_records_expression_id_fkey")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "learning_records_user_feed_idx")
  @@map("learning_records")
}

/// Successful commands only; their response snapshot commits with the business writes.
model CommandReceipt {
  userId      String @map("user_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  action      String @db.Text
  candidateId String @map("candidate_id") @db.Uuid
  fingerprint String @db.Text
  statusCode  Int @map("status_code")
  response    Json @db.JsonB
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "command_receipts_user_id_fkey")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "command_receipts_candidate_id_fkey")

  @@id([userId, operationId], map: "command_receipts_pkey")
  @@map("command_receipts")
}
