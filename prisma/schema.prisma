generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id(map: "users_pkey") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  captures  Capture[]

  @@map("users")
}

/// CHECK constraints are maintained in migration SQL.
model Capture {
  id           String   @id(map: "captures_pkey") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  originalText String   @map("original_text") @db.Text
  chineseIntent String? @map("chinese_intent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revisions    CaptureRevision[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "captures_user_id_fkey")

  @@index([userId], map: "captures_user_id_idx")
  @@map("captures")
}

/// Content snapshots. CHECK constraints are maintained in migration SQL.
model CaptureRevision {
  id            String   @id(map: "capture_revisions_pkey") @db.Uuid
  captureId     String   @map("capture_id") @db.Uuid
  revisionNo    Int      @map("revision_no")
  originalText  String   @map("original_text") @db.Text
  chineseIntent String?  @map("chinese_intent") @db.Text
  inputSource   String   @map("input_source") @db.Text
  chunks        Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  capture       Capture  @relation(fields: [captureId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "capture_revisions_capture_id_fkey")
  candidates    Candidate[]

  @@unique([captureId, revisionNo], map: "capture_revisions_capture_no_key")
  @@map("capture_revisions")
}

/// Candidate content is immutable through the API; CHECK constraints live in SQL.
model Candidate {
  id             String   @id(map: "candidates_pkey") @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  candidateNo    Int      @map("candidate_no")
  englishText    String   @map("english_text") @db.Text
  chineseMeaning String   @map("chinese_meaning") @db.Text
  status         String   @default("pending") @db.Text
  discardedAt    DateTime? @map("discarded_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revision       CaptureRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "candidates_revision_id_fkey")

  @@unique([revisionId, candidateNo], map: "candidates_revision_no_key")
  @@map("candidates")
}
