{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EPP: attach to npm run dev",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "timeout": 30000,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/.dev/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "EPP: build and launch",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/src/server.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "EPP: build",
      "runtimeArgs": [
        "--enable-source-maps",
        "--env-file-if-exists=.env"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "EPP: attach to npm run debug",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "Chapter 37: mini session (local VERIFY)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9470,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
